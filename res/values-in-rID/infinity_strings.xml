<!-- Security -->
<string name="security_settings_face_enroll_introduction_info_title_en">Perlu diingat</string>
<string name="security_settings_face_enroll_introduction_how_title_en">Cara kerjanya</string>
<string name="security_settings_face_enroll_introduction_info_glasses_en">Kacamata atau kacamata hitam ringan tidak masalah.</string>
<string name="security_settings_face_enroll_introduction_info_looking_en">Menatap telepon dapat membuka kunci bahkan ketika Anda tidak bermaksud. Telepon Anda juga dapat dibuka oleh seseorang yang sangat mirip dengan Anda, seperti saudara kembar, atau jika seseorang mengarahkannya ke wajah Anda.</string>
<string name="security_settings_face_enroll_introduction_info_less_secure_en">Menggunakan wajah untuk membuka kunci telepon mungkin kurang aman daripada pola atau PIN yang kuat.</string>
<string name="security_settings_face_enroll_introduction_info_gaze_en">Face Unlock dapat meminta mata Anda terbuka untuk membuka kunci telepon atau memverifikasi bahwa itu Anda. Anda dapat mengaktifkan opsi ini kapan saja di Pengaturan.</string>
<string name="security_settings_face_enroll_introduction_how_message_en">Face Unlock membuat model unik wajah Anda untuk memverifikasi bahwa itu Anda. Untuk membuat model wajah ini selama pengaturan, Anda akan mengambil gambar wajah Anda dari sudut yang berbeda.\n\nKetika Anda menggunakan Face Unlock, gambar digunakan untuk memperbarui model wajah Anda. Gambar yang digunakan untuk membuat model wajah Anda tidak disimpan, tetapi model wajah disimpan dengan aman di telepon Anda dan tidak pernah meninggalkan telepon. Semua pemrosesan terjadi dengan aman di telepon Anda.</string>
<string name="security_settings_face_enroll_introduction_control_title_en">Anda yang mengendalikan</string>
<string name="security_settings_face_enroll_introduction_control_message_en">Anda dapat menghapus model wajah Anda atau mematikan Face Unlock kapan saja di Pengaturan. Model wajah disimpan di telepon sampai Anda menghapusnya.\n\nPelajari lebih lanjut di g.co/pixel/faceunlock.</string>

